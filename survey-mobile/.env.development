# Development and test builds (expo start, scripts/build-apk.ps1 -Profile test). Committed: everything here is PUBLIC.
# EXPO_PUBLIC_ values are built into the app and readable by anyone with the APK. Never put secrets here.
# Put your own LAN address in .env.development.local (git-ignored), e.g. EXPO_PUBLIC_API_URL=http://192.168.1.53:5000
# 10.0.2.2 is the host PC as seen from the Android emulator.
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
# Shows Quick sign-in and the editable server address. The API serves dev login only in Development with a local database.
EXPO_PUBLIC_DEV_LOGIN=true
